# Application
APP_NAME="Mediahuus CRM"
APP_ENV=production
DEBUG=false

# Database
DB_HOST=db
DB_PORT=3306
DB_DATABASE=crm_mediahuus
DB_USERNAME=root
DB_PASSWORD=root

# Twig
# false/leer = kein Cache, true = var/cache/twig, sonst Pfad (relativ ab Projektverzeichnis).
# Templates werden bei Änderungen immer neu kompiliert (auto_reload).
TWIG_CACHE=false

# Session
SESSION_NAME=mediahuus_crm_session
SESSION_LIFETIME=7200

# Logging
LOG_LEVEL=info
LOG_PATH=logs/app.log

# PDF
PDF_TEMP_DIR=tmp/pdf
# Mail (alle E-Mails laufen über MailService / Mailgun)
# leer = kein Versand (nur Log); Mailgun: mailgun+api://KEY:DOMAIN@default?region=eu
# lokal: MAILER_DSN=smtp://localhost:1025 (DDEV Mailpit)
MAILER_DSN=
MAIL_FROM=info@mediahuus.ch
MAIL_FROM_NAME="Mediahuus"
APP_URL=https://crm.mediahuus.ch
