<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mediahuus{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f3f4f6;">
        <tr>
            <td align="center" style="padding:24px 12px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background-color:#ffffff;border-radius:8px;">
                    <tr>
                        <td style="padding:20px 28px;background-color:#059669;border-radius:8px 8px 0 0;color:#ffffff;font-size:20px;font-weight:bold;">
                            Mediahuus
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:28px;font-size:15px;line-height:1.5;">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:16px 28px 24px;border-top:1px solid #e5e7eb;font-size:13px;color:#6b7280;line-height:1.5;">
                            <strong>{{ branch.name }}</strong><br>
                            {{ branch.street }}, {{ branch.zip }} {{ branch.city }}
                            {% if branch.phone %}<br>Telefon {{ branch.phone }}{% endif %}
                            {% if branch.email %}<br>{{ branch.email }}{% endif %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
