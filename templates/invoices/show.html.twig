{% extends "base.html.twig" %}

{% block title %}Rechnung {{ document.doc_number }} - {{ parent() }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
        <div class="mb-8">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-gray-900">Rechnung {{ document.doc_number }}</h2>
                    <p class="text-gray-600">Erstellt am {{ document.created_at|date('d.m.Y') }} um {{ document.created_at|date('H:i') }}</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a href="/" class="mediahuus-button-secondary">← Zurück zum Dashboard</a>
                    <a href="{{ url_for('invoices.pdf', {id: document.id}) }}" class="mediahuus-button-primary">PDF herunterladen</a>
                </div>
            </div>
        </div>

        <div class="bg-white shadow rounded-lg p-6 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Empfänger</h3>
                    <dl class="space-y-2">
                        {% if invoice.company_name %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Firma:</dt>
                            <dd class="text-sm text-gray-900">{% if document.customer_id %}<a href="{{ url_for('customers.show', {id: document.customer_id}) }}" class="text-emerald-700 hover:underline">{{ invoice.company_name }}</a>{% else %}{{ invoice.company_name }}{% endif %}</dd>
                        </div>
                        {% endif %}
                        {% if invoice.contact_name %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Name:</dt>
                            <dd class="text-sm text-gray-900">{% if document.customer_id %}<a href="{{ url_for('customers.show', {id: document.customer_id}) }}" class="text-emerald-700 hover:underline">{{ invoice.contact_name }}</a>{% else %}{{ invoice.contact_name }}{% endif %}</dd>
                        </div>
                        {% endif %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Adresse:</dt>
                            <dd class="text-sm text-gray-900">
                                {{ document.customer_street }}<br>
                                {{ document.customer_zip }} {{ document.customer_city }}
                            </dd>
                        </div>
                    </dl>
                </div>

                <div>
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Rechnungsdaten</h3>
                    <dl class="space-y-2">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Nummer:</dt>
                            <dd class="text-sm text-gray-900">{{ document.doc_number }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Rechnungsdatum:</dt>
                            <dd class="text-sm text-gray-900">{{ invoice.invoice_date|date('d.m.Y') }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Zahlungsfrist:</dt>
                            <dd class="text-sm text-gray-900">{{ invoice.payment_term_days }} Tage (zahlbar bis {{ invoice.due_date|date('d.m.Y') }})</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Referenz (QR-Zahlteil):</dt>
                            <dd class="text-sm text-gray-900 break-all">{{ invoice.qr_reference }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Filiale:</dt>
                            <dd class="text-sm text-gray-900">{{ branch.name }}</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>

        <div class="bg-white shadow rounded-lg p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Positionen</h3>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Beschreibung</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Menge</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Einzelpreis</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">MWST</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Summe</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for item in invoice.items %}
                            <tr>
                                <td class="px-4 py-3 whitespace-pre-wrap text-sm text-gray-900">{{ item.description }}</td>
                                <td class="px-4 py-3 text-right text-sm text-gray-900">{{ item.quantity|number_format(2, '.', "'")|replace({'.00': ''}) }}</td>
                                <td class="px-4 py-3 text-right text-sm text-gray-900">{{ item.unit_price_gross_chf|number_format(2, '.', "'") }}</td>
                                <td class="px-4 py-3 text-right text-sm text-gray-900">{{ item.vat_rate }} %</td>
                                <td class="px-4 py-3 text-right text-sm font-medium text-gray-900">{{ item.line_total_gross_chf|number_format(2, '.', "'") }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot class="bg-gray-50">
                        <tr>
                            <td colspan="4" class="px-4 py-2 text-right text-sm text-gray-700">Total exkl. MWST</td>
                            <td class="px-4 py-2 text-right text-sm text-gray-900">{{ invoice.total_net_chf|number_format(2, '.', "'") }}</td>
                        </tr>
                        {% for rate, group in invoice.vat_groups %}
                        <tr>
                            <td colspan="4" class="px-4 py-2 text-right text-sm text-gray-700">MWST {{ rate }} % auf {{ group.net|number_format(2, '.', "'") }}</td>
                            <td class="px-4 py-2 text-right text-sm text-gray-900">{{ group.vat|number_format(2, '.', "'") }}</td>
                        </tr>
                        {% endfor %}
                        <tr>
                            <td colspan="4" class="px-4 py-3 text-right text-sm font-medium text-gray-900">Total inkl. MWST (CHF)</td>
                            <td class="px-4 py-3 text-right text-lg font-bold" style="color: #2d8f3e;">{{ invoice.total_gross_chf|number_format(2, '.', "'") }}</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="mt-6 flex flex-wrap justify-center gap-4">
            <a href="{{ url_for('invoices.pdf', {id: document.id}) }}" class="mediahuus-button-primary">PDF herunterladen</a>
            <a href="{{ url_for('invoices.create') }}" class="mediahuus-button-secondary">Neue Rechnung erstellen</a>
        </div>
    </div>
</div>
{% endblock %}
