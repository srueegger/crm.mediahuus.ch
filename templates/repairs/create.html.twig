{% extends "base.html.twig" %}

{% set isEdit = mode|default('create') == 'edit' %}
{% set showUnlockCode = not isEdit or repair.is_open %}

{% block title %}{{ isEdit ? 'Reparatur ' ~ document.doc_number ~ ' bearbeiten' : 'Neue Reparatur' }} - {{ parent() }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
        <div class="mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-2">{{ isEdit ? 'Reparatur ' ~ document.doc_number ~ ' bearbeiten' : 'Neue Reparatur' }}</h2>
            <p class="text-gray-600">{{ isEdit ? 'Angaben zum Reparaturauftrag ändern' : 'Gerät zur Reparatur annehmen' }}</p>
        </div>

        {% if errors|length > 0 %}
            <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
                Bitte die markierten Felder prüfen.
            </div>
        {% endif %}

        <div class="mediahuus-form-section">
            <form method="POST" action="{{ isEdit ? url_for('repairs.update', {id: document.id}) : url_for('repairs.store') }}" class="space-y-8">
                {{ csrf_field() }}

                <!-- Filiale -->
                <div class="border-b border-gray-200 pb-8">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Filiale</h3>
                    <label for="branch_id" class="mediahuus-label">Filiale auswählen *</label>
                    <select name="branch_id" id="branch_id" required
                            class="mediahuus-select {{ errors.branch_id is defined ? 'error' : '' }}">
                        <option value="">-- Filiale auswählen --</option>
                        {% for branch in branches %}
                            <option value="{{ branch.id }}" {% if formData.branch_id|default('') == branch.id %}selected{% endif %}>
                                {{ branch.name }} - {{ branch.full_address }}
                            </option>
                        {% endfor %}
                    </select>
                    {% if errors.branch_id is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.branch_id }}</p>{% endif %}
                </div>

                <!-- Kundendaten -->
                <div class="border-b border-gray-200 pb-8">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Kundendaten</h3>
                    {% include 'customers/_picker.html.twig' with { fieldMap: customerFieldMap, linkedCustomer: linkedCustomer, customerId: formData.customer_id|default('') } %}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="md:col-span-2">
                            <label for="customer_name" class="mediahuus-label">Name des Kunden *</label>
                            <input type="text" name="customer_name" id="customer_name" required
                                   value="{{ formData.customer_name|default('') }}"
                                   class="mediahuus-input {{ errors.customer_name is defined ? 'error' : '' }}"
                                   placeholder="Max Mustermann">
                            {% if errors.customer_name is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.customer_name }}</p>{% endif %}
                        </div>
                        <div>
                            <label for="customer_phone" class="mediahuus-label">Telefon</label>
                            <input type="tel" name="customer_phone" id="customer_phone"
                                   value="{{ formData.customer_phone|default('') }}"
                                   class="mediahuus-input {{ errors.customer_phone is defined ? 'error' : '' }}"
                                   placeholder="+41 61 123 45 67">
                            {% if errors.customer_phone is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.customer_phone }}</p>{% endif %}
                        </div>
                        <div>
                            <label for="customer_email" class="mediahuus-label">E-Mail</label>
                            <input type="email" name="customer_email" id="customer_email"
                                   value="{{ formData.customer_email|default('') }}"
                                   class="mediahuus-input {{ errors.customer_email is defined ? 'error' : '' }}"
                                   placeholder="kunde@example.com">
                            {% if errors.customer_email is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.customer_email }}</p>{% endif %}
                            <p class="mt-1 text-sm text-gray-500">Mit E-Mail erhält der Kunde die Auftragsbestätigung und eine Nachricht, sobald das Gerät abholbereit ist.</p>
                        </div>
                    </div>
                </div>

                <!-- Gerät -->
                <div class="border-b border-gray-200 pb-8">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Gerät</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="device_name" class="mediahuus-label">Gerät / Modell *</label>
                            <input type="text" name="device_name" id="device_name" required maxlength="255"
                                   value="{{ formData.device_name|default('') }}"
                                   class="mediahuus-input {{ errors.device_name is defined ? 'error' : '' }}"
                                   placeholder="z.B. iPhone 15 Pro">
                            {% if errors.device_name is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.device_name }}</p>{% endif %}
                        </div>
                        <div>
                            <label for="imei_serial" class="mediahuus-label">IMEI / Seriennummer</label>
                            <input type="text" name="imei_serial" id="imei_serial" maxlength="64"
                                   value="{{ formData.imei_serial|default('') }}"
                                   class="mediahuus-input {{ errors.imei_serial is defined ? 'error' : '' }}">
                            {% if errors.imei_serial is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.imei_serial }}</p>{% endif %}
                        </div>
                        <div>
                            <label for="accessories" class="mediahuus-label">Zubehör</label>
                            <input type="text" name="accessories" id="accessories" maxlength="255"
                                   value="{{ formData.accessories|default('') }}"
                                   class="mediahuus-input {{ errors.accessories is defined ? 'error' : '' }}"
                                   placeholder="z.B. Hülle, Ladekabel">
                            {% if errors.accessories is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.accessories }}</p>{% endif %}
                        </div>
                        {% if showUnlockCode %}
                            <div>
                                <label for="unlock_code" class="mediahuus-label">Entsperrcode</label>
                                <input type="text" name="unlock_code" id="unlock_code" maxlength="100" autocomplete="off"
                                       value="{{ formData.unlock_code|default('') }}"
                                       class="mediahuus-input {{ errors.unlock_code is defined ? 'error' : '' }}">
                                {% if errors.unlock_code is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.unlock_code }}</p>{% endif %}
                                <p class="mt-1 text-sm text-gray-500">Nur intern sichtbar. Wird beim Abschluss der Reparatur gelöscht.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Reparatur -->
                <div class="pb-8">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Reparatur</h3>
                    <div class="space-y-6">
                        <div>
                            <label for="damage_type" class="mediahuus-label">Schadenstyp</label>
                            <select name="damage_type" id="damage_type"
                                    class="mediahuus-select {{ errors.damage_type is defined ? 'error' : '' }}">
                                <option value="">-- Schadenstyp auswählen --</option>
                                {% for value, label in damageTypes %}
                                    <option value="{{ value }}" {% if formData.damage_type|default('') == value %}selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                            {% if errors.damage_type is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.damage_type }}</p>{% endif %}
                        </div>
                        <div>
                            <label for="issue_text" class="mediahuus-label">Fehlerbeschreibung *</label>
                            <textarea name="issue_text" id="issue_text" rows="4" required
                                      class="mediahuus-textarea {{ errors.issue_text is defined ? 'error' : '' }}"
                                      placeholder="Was ist defekt? Wie äussert sich der Fehler?">{{ formData.issue_text|default('') }}</textarea>
                            {% if errors.issue_text is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.issue_text }}</p>{% endif %}
                        </div>
                        <div>
                            <label for="work_text" class="mediahuus-label">Geplante Arbeiten</label>
                            <textarea name="work_text" id="work_text" rows="3"
                                      class="mediahuus-textarea {{ errors.work_text is defined ? 'error' : '' }}"
                                      placeholder="z.B. Display ersetzen">{{ formData.work_text|default('') }}</textarea>
                            {% if errors.work_text is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.work_text }}</p>{% endif %}
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="price_chf" class="mediahuus-label">Voraussichtlicher Preis (CHF)</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <span class="text-gray-500 sm:text-sm">CHF</span>
                                    </div>
                                    <input type="text" inputmode="decimal" name="price_chf" id="price_chf"
                                           value="{{ formData.price_chf|default('') }}"
                                           class="mediahuus-input {{ errors.price_chf is defined ? 'error' : '' }}"
                                           style="padding-left: 4rem !important;"
                                           placeholder="0.00">
                                </div>
                                {% if errors.price_chf is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.price_chf }}</p>{% endif %}
                                <p class="mt-1 text-sm text-gray-500">Inkl. MWST.</p>
                            </div>
                            <div>
                                <label for="due_date" class="mediahuus-label">Fertig bis</label>
                                <input type="date" name="due_date" id="due_date"
                                       value="{{ formData.due_date|default('') }}"
                                       class="mediahuus-input {{ errors.due_date is defined ? 'error' : '' }}">
                                {% if errors.due_date is defined %}<p class="mt-1 text-sm text-red-600">{{ errors.due_date }}</p>{% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end space-x-3 pt-6 border-t">
                    <a href="{{ isEdit ? url_for('repairs.show', {id: document.id}) : url_for('repairs.index') }}" class="mediahuus-button-secondary">Abbrechen</a>
                    <button type="submit" class="mediahuus-button-primary">{{ isEdit ? 'Änderungen speichern' : 'Reparatur erfassen' }}</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/customer-picker.js" defer></script>
{% endblock %}
