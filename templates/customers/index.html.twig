{% extends "base.html.twig" %}

{% block title %}Kunden - {{ parent() }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
        <div class="mb-8 flex justify-between items-center">
            <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-2">Kunden</h2>
                <p class="text-gray-600">{{ total }} Kunden{% if q %} (gefiltert){% endif %}</p>
            </div>
            <a href="{{ url_for('customers.create') }}" class="mediahuus-button-primary">Neuer Kunde</a>
        </div>

        {% if error == 'notfound' %}
            <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">Kunde nicht gefunden.</div>
        {% endif %}

        <form method="get" action="{{ url_for('customers.index') }}" class="mb-6 flex gap-3">
            <input type="text" name="q" value="{{ q }}" class="mediahuus-input" placeholder="Suche nach Name, Firma, Telefon, E-Mail oder Dokumentnummer">
            <button type="submit" class="mediahuus-button-primary">Suchen</button>
            {% if q %}<a href="{{ url_for('customers.index') }}" class="mediahuus-button-secondary">Zurücksetzen</a>{% endif %}
        </form>

        <div class="bg-white shadow overflow-hidden sm:rounded-md">
            {% if rows|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name / Firma</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Telefon</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ort</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dokumente</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Letztes Dokument</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for row in rows %}
                                {% set c = row.customer.toArray() %}
                                <tr class="hover:bg-emerald-50">
                                    <td class="px-6 py-4 text-sm font-medium">
                                        <a href="{{ url_for('customers.show', {id: c.id}) }}" class="text-emerald-600 hover:text-emerald-700">{{ c.display_name }}</a>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-500">{{ c.phone }}</td>
                                    <td class="px-6 py-4 text-sm text-gray-500">{{ c.city }}</td>
                                    <td class="px-6 py-4 text-sm text-gray-500">{{ row.document_count }}</td>
                                    <td class="px-6 py-4 text-sm text-gray-500">{{ row.last_document_at ? row.last_document_at|date('d.m.Y') : '' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if pages > 1 %}
                    <div class="px-6 py-4 border-t border-gray-200 flex items-center justify-between text-sm text-gray-600">
                        <span>Seite {{ page }} von {{ pages }}</span>
                        <div class="flex gap-2">
                            {% if page > 1 %}
                                <a href="{{ url_for('customers.index') }}?q={{ q|url_encode }}&page={{ page - 1 }}" class="mediahuus-button-secondary">Zurück</a>
                            {% endif %}
                            {% if page < pages %}
                                <a href="{{ url_for('customers.index') }}?q={{ q|url_encode }}&page={{ page + 1 }}" class="mediahuus-button-secondary">Weiter</a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <div class="text-center py-12">
                    <h3 class="text-sm font-medium text-gray-900">Keine Kunden gefunden</h3>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
