{% extends "base.html.twig" %}

{% block title %}{{ customer.display_name }} - {{ parent() }}{% endblock %}

{% block content %}
<div class="max-w-5xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
        <div class="mb-6 flex justify-between items-center">
            <div>
                <a href="{{ url_for('customers.index') }}" class="text-sm text-emerald-600 hover:text-emerald-700">&larr; Alle Kunden</a>
                <h2 class="text-2xl font-bold text-gray-900 mt-2">{{ customer.display_name }}</h2>
            </div>
            <a href="{{ url_for('customers.edit', {id: customer.id}) }}" class="mediahuus-button-primary">Bearbeiten</a>
        </div>

        {% if success == 'created' %}
            <div class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">Kunde erfolgreich erstellt.</div>
        {% elseif success == 'updated' %}
            <div class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">Kunde erfolgreich aktualisiert.</div>
        {% elseif success == 'merged' %}
            <div class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">Kunden erfolgreich zusammengeführt.</div>
        {% endif %}
        {% if error == 'merge' %}
            <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">Zusammenführen nicht möglich: Bitte einen anderen, existierenden Kunden wählen.</div>
        {% endif %}

        <div class="mediahuus-form-section mb-6">
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                <div><dt class="text-gray-500">Firma</dt><dd class="text-gray-900">{{ customer.company_name|default('–') }}</dd></div>
                <div><dt class="text-gray-500">Name</dt><dd class="text-gray-900">{{ customer.name }}</dd></div>
                <div><dt class="text-gray-500">Telefon</dt><dd class="text-gray-900">{{ customer.phone|default('–') }}</dd></div>
                <div><dt class="text-gray-500">E-Mail</dt><dd class="text-gray-900">{{ customer.email|default('–') }}</dd></div>
                <div><dt class="text-gray-500">Adresse</dt><dd class="text-gray-900">{% if customer.street or customer.zip or customer.city %}{{ customer.street }}{% if customer.street and (customer.zip or customer.city) %}, {% endif %}{{ customer.zip }} {{ customer.city }}{% else %}–{% endif %}</dd></div>
                <div class="sm:col-span-2"><dt class="text-gray-500">Notizen</dt><dd class="text-gray-900 whitespace-pre-line">{{ customer.notes|default('–') }}</dd></div>
            </dl>
        </div>

        <div class="mb-6 flex flex-wrap gap-2">
            <a href="{{ url_for('estimates.create') }}?customer_id={{ customer.id }}" class="mediahuus-button-secondary">Neuer Kostenvoranschlag</a>
            <a href="{{ url_for('receipts.create') }}?customer_id={{ customer.id }}" class="mediahuus-button-secondary">Neue Quittung</a>
            <a href="{{ url_for('invoices.create') }}?customer_id={{ customer.id }}" class="mediahuus-button-secondary">Neue Rechnung</a>
            <a href="{{ url_for('purchases.create') }}?customer_id={{ customer.id }}" class="mediahuus-button-secondary">Neuer Ankauf</a>
            <a href="{{ url_for('insurance.create') }}?customer_id={{ customer.id }}" class="mediahuus-button-secondary">Neues Gutachten</a>
        </div>

        <div class="mediahuus-form-section mb-6">
            <h3 class="text-lg font-medium text-gray-900 mb-1">Mit anderem Kunden zusammenführen</h3>
            <p class="text-sm text-gray-500 mb-4">Der hier gewählte Kunde bleibt bestehen und erhält alle Dokumente; der aktuelle Kunde «{{ customer.display_name }}» wird gelöscht.</p>
            <form method="get" action="{{ url_for('customers.merge', {id: customer.id}) }}">
                {% include 'customers/_picker.html.twig' with { fieldMap: {}, linkedCustomer: null, customerId: '', inputName: 'target', autosubmit: true } %}
            </form>
        </div>

        <div class="bg-white shadow overflow-hidden sm:rounded-md">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">Dokumente ({{ documents|length }})</h3>
            </div>
            {% if documents|length > 0 %}
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Typ</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nummer</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Datum</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Filiale</th>
                            <th class="px-6 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        {% for row in documents %}
                            <tr>
                                <td class="px-6 py-4 text-sm text-gray-900">{{ row.type_label }}</td>
                                <td class="px-6 py-4 text-sm text-gray-900">{{ row.document.doc_number }}</td>
                                <td class="px-6 py-4 text-sm text-gray-500">{{ row.document.created_at|date('d.m.Y') }}</td>
                                <td class="px-6 py-4 text-sm text-gray-500">{{ row.branch_name }}</td>
                                <td class="px-6 py-4 text-sm text-right space-x-3">
                                    {% if row.show_url %}<a href="{{ row.show_url }}" class="text-emerald-600 hover:text-emerald-700">Ansehen</a>{% endif %}
                                    {% if row.pdf_url %}<a href="{{ row.pdf_url }}" class="text-emerald-600 hover:text-emerald-700">PDF</a>{% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="px-6 py-8 text-sm text-gray-500 text-center">Noch keine Dokumente.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/assets/js/customer-picker.js" defer></script>
{% endblock %}
