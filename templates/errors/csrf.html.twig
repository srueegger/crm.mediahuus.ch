{% extends "base.html.twig" %}

{% block title %}{{ title }} - {{ parent() }}{% endblock %}

{% block content %}
<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full mediahuus-form-section text-center space-y-6">
        <div class="flex justify-center">
            <div class="h-12 w-12 rounded-full bg-emerald-100 flex items-center justify-center">
                <svg class="h-6 w-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                </svg>
            </div>
        </div>
        <h2 class="text-2xl font-extrabold text-gray-900">{{ title }}</h2>
        <p class="text-sm text-gray-600">{{ message }}</p>
        <a href="{{ back_url }}" class="mediahuus-button-primary inline-block">Zurück</a>
    </div>
</div>
{% endblock %}
